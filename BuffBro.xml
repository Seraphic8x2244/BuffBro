<Ui xmlns="http://www.blizzard.com/wow/ui/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">

    <Frame name="BuffBroEventFrame">
        <Scripts>
            <OnLoad>
                BuffBro_OnLoad();
            </OnLoad>
            <OnEvent>
                BuffBro_OnEvent(event, arg1, arg2, arg3, arg4);
            </OnEvent>
            <OnUpdate>
                BuffBro_OnUpdate(arg1);
            </OnUpdate>
        </Scripts>
    </Frame>

    <Frame name="BuffBroDebugFrame" parent="UIParent" hidden="true" movable="true" enableMouse="true">
        <Size>
            <AbsDimension x="620" y="430"/>
        </Size>
        <Anchors>
            <Anchor point="CENTER"/>
        </Anchors>

        <Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background"
                  edgeFile="Interface\DialogFrame\UI-DialogBox-Border"
                  tile="true">
            <BackgroundInsets>
                <AbsInset left="11" right="12" top="12" bottom="11"/>
            </BackgroundInsets>
            <TileSize>
                <AbsValue val="32"/>
            </TileSize>
            <EdgeSize>
                <AbsValue val="32"/>
            </EdgeSize>
        </Backdrop>

        <Layers>
            <Layer level="ARTWORK">
                <FontString name="BuffBroDebugTitle" inherits="GameFontNormalLarge" text="BuffBro Debug">
                    <Anchors>
                        <Anchor point="TOP" relativePoint="TOP">
                            <Offset>
                                <AbsDimension x="0" y="-16"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>

                <FontString name="BuffBroDebugSubtitle" inherits="GameFontHighlightSmall" text="Backend / execution queue / executor state">
                    <Anchors>
                        <Anchor point="TOP" relativeTo="BuffBroDebugTitle" relativePoint="BOTTOM">
                            <Offset>
                                <AbsDimension x="0" y="-2"/>
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>

        <Scripts>
            <OnMouseDown>
                if arg1 == "LeftButton" then this:StartMoving(); end
            </OnMouseDown>
            <OnMouseUp>
                this:StopMovingOrSizing();
            </OnMouseUp>
        </Scripts>

        <Frames>
            <Button name="BuffBroDebugClose" inherits="UIPanelCloseButton">
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset>
                            <AbsDimension x="-4" y="-4"/>
                        </Offset>
                    </Anchor>
                </Anchors>
            </Button>

            <Button name="BuffBroDebugRosterButton" inherits="UIPanelButtonTemplate" text="Roster">
                <Size><AbsDimension x="82" y="22"/></Size>
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset><AbsDimension x="18" y="-48"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts><OnClick>BuffBro_DebugShow("roster");</OnClick></Scripts>
            </Button>

            <Button name="BuffBroDebugProvidersButton" inherits="UIPanelButtonTemplate" text="Providers">
                <Size><AbsDimension x="82" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="BuffBroDebugRosterButton" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts><OnClick>BuffBro_DebugShow("providers");</OnClick></Scripts>
            </Button>

            <Button name="BuffBroDebugAssignmentsButton" inherits="UIPanelButtonTemplate" text="Assignments">
                <Size><AbsDimension x="90" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="BuffBroDebugProvidersButton" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts><OnClick>BuffBro_DebugShow("assignments");</OnClick></Scripts>
            </Button>

            <Button name="BuffBroDebugAurasButton" inherits="UIPanelButtonTemplate" text="Auras">
                <Size><AbsDimension x="72" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="BuffBroDebugAssignmentsButton" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts><OnClick>BuffBro_DebugShow("auras");</OnClick></Scripts>
            </Button>

            <Button name="BuffBroDebugQueueButton" inherits="UIPanelButtonTemplate" text="Queue">
                <Size><AbsDimension x="72" y="22"/></Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="BuffBroDebugAurasButton" relativePoint="RIGHT">
                        <Offset><AbsDimension x="4" y="0"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts><OnClick>BuffBro_DebugShow("queue");</OnClick></Scripts>
            </Button>

            <Button name="BuffBroDebugRefreshButton" inherits="UIPanelButtonTemplate" text="Refresh">
                <Size><AbsDimension x="78" y="22"/></Size>
                <Anchors>
                    <Anchor point="TOPRIGHT">
                        <Offset><AbsDimension x="-20" y="-48"/></Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnClick>
                        BuffBro.ScanLocalProvider("debug");
                        BuffBro.RebuildRoster("debug");
                        BuffBro_DebugRender(BuffBro.Debug.view or "queue");
                    </OnClick>
                </Scripts>
            </Button>

            <ScrollFrame name="BuffBroDebugScrollFrame" inherits="UIPanelScrollFrameTemplate">
                <Anchors>
                    <Anchor point="TOPLEFT">
                        <Offset><AbsDimension x="22" y="-82"/></Offset>
                    </Anchor>
                    <Anchor point="BOTTOMRIGHT">
                        <Offset><AbsDimension x="-44" y="22"/></Offset>
                    </Anchor>
                </Anchors>

                <ScrollChild>
                    <Frame name="BuffBroDebugScrollChild">
                        <Size><AbsDimension x="540" y="1200"/></Size>
                        <Layers>
                            <Layer level="ARTWORK">
                                <FontString name="BuffBroDebugText" inherits="GameFontHighlightSmall" justifyH="LEFT" justifyV="TOP">
                                    <Size><AbsDimension x="530" y="1180"/></Size>
                                    <Anchors>
                                        <Anchor point="TOPLEFT">
                                            <Offset><AbsDimension x="4" y="-4"/></Offset>
                                        </Anchor>
                                    </Anchors>
                                </FontString>
                            </Layer>
                        </Layers>
                    </Frame>
                </ScrollChild>
            </ScrollFrame>
        </Frames>
    </Frame>

    <Frame name="BuffBroMiniFrame" parent="UIParent" enableMouse="true" movable="true">
        <Size>
            <AbsDimension x="102" y="32"/>
        </Size>
        <Frames>
            <Button name="BuffBroMenuButton" inherits="UIPanelButtonTemplate" text="BB">
                <Size>
                    <AbsDimension x="34" y="30"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativePoint="LEFT"/>
                </Anchors>
                <Scripts>
                    <OnClick>
                        BuffBro_MenuButton_OnClick();
                    </OnClick>
                    <OnMouseDown>
                        BuffBro_MenuButton_OnMouseDown();
                    </OnMouseDown>
                    <OnMouseUp>
                        BuffBro_MenuButton_OnMouseUp();
                    </OnMouseUp>
                </Scripts>
            </Button>

            <Button name="BuffBroCastButton">
                <Size>
                    <AbsDimension x="30" y="30"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="BuffBroMenuButton" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="4" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture name="BuffBroCastBorder" file="Interface\Buttons\WHITE8X8">
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="BOTTOMRIGHT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="ARTWORK">
                        <Texture name="BuffBroCastIcon">
                            <Anchors>
                                <Anchor point="TOPLEFT">
                                    <Offset><AbsDimension x="2" y="-2"/></Offset>
                                </Anchor>
                                <Anchor point="BOTTOMRIGHT">
                                    <Offset><AbsDimension x="-2" y="2"/></Offset>
                                </Anchor>
                            </Anchors>
                        </Texture>
                    </Layer>
                    <Layer level="OVERLAY">
                        <Texture file="Interface\Buttons\UI-Quickslot-Depress">
                            <Anchors>
                                <Anchor point="TOPLEFT"/>
                                <Anchor point="BOTTOMRIGHT"/>
                            </Anchors>
                        </Texture>
                    </Layer>
                </Layers>
                <Frames>
                    <Cooldown name="BuffBroCastCooldown" inherits="CooldownFrameTemplate">
                        <Anchors>
                            <Anchor point="TOPLEFT" relativeTo="BuffBroCastIcon" relativePoint="TOPLEFT"/>
                            <Anchor point="BOTTOMRIGHT" relativeTo="BuffBroCastIcon" relativePoint="BOTTOMRIGHT"/>
                        </Anchors>
                    </Cooldown>
                </Frames>
                <Scripts>
                    <OnClick>
                        BuffBro_CastButton_OnClick();
                    </OnClick>
                    <OnEnter>
                        BuffBro_CastButton_OnEnter();
                    </OnEnter>
                    <OnLeave>
                        BuffBro_CastButton_OnLeave();
                    </OnLeave>
                </Scripts>
            </Button>

            <Button name="BuffBroStatusButton" inherits="UIPanelButtonTemplate" hidden="true">
                <Size>
                    <AbsDimension x="30" y="22"/>
                </Size>
                <Anchors>
                    <Anchor point="LEFT" relativeTo="BuffBroCastButton" relativePoint="RIGHT">
                        <Offset>
                            <AbsDimension x="4" y="0"/>
                        </Offset>
                    </Anchor>
                </Anchors>
                <Scripts>
                    <OnEnter>
                        BuffBro_StatusButton_OnEnter();
                    </OnEnter>
                    <OnLeave>
                        BuffBro_StatusButton_OnLeave();
                    </OnLeave>
                </Scripts>
            </Button>
        </Frames>
    </Frame>

</Ui>
